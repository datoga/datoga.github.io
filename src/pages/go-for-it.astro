---
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import { MENTORING } from "@consts";
---

<PageLayout title={MENTORING.TITLE} description={MENTORING.DESCRIPTION}>
	<Container>
		<h1 class="animate text-2xl font-semibold text-black dark:text-white">
			{MENTORING.PAGE_TITLE || MENTORING.TITLE}
		</h1>
		<div class="space-y-16">
			<!-- Intro + Video -->
			<section class="space-y-6">
				<article class="space-y-4">
					{
						MENTORING.PARAGRAPHS.map((paragraph) => (
							<p class="animate" set:html={paragraph} />
						))
					}
					{
						MENTORING.CALLOUT && (
							<div class="animate p-6 rounded-xl border-l-4 border-blue-500 bg-blue-50 dark:bg-blue-950/30 shadow-md space-y-4">
								{MENTORING.CALLOUT_TITLE && (
									<p class="text-xl font-bold text-blue-900 dark:text-blue-100">
										{MENTORING.CALLOUT_TITLE}
									</p>
								)}
								<p
									class="text-base font-medium text-blue-900 dark:text-blue-100 leading-relaxed"
									set:html={MENTORING.CALLOUT}
								/>
								{MENTORING.CALLOUT_SUBTITLE && (
									<h3 class="text-lg font-semibold text-blue-900 dark:text-blue-100 pt-2">
										{MENTORING.CALLOUT_SUBTITLE}
									</h3>
								)}
								{MENTORING.FEATURES && (
									<ul class="space-y-2 list-none text-blue-800 dark:text-blue-200">
										{MENTORING.FEATURES.map((feature) => (
											<li>{feature}</li>
										))}
									</ul>
								)}
							</div>
						)
					}
				</article>
			</section>

			<!-- WhatsApp Community -->
			<section class="animate">
				<a
					href={MENTORING.WHATSAPP_LINK}
					target="_blank"
					rel="noopener noreferrer"
					class="flex items-center justify-center gap-4 w-full p-6 rounded-xl bg-[#25D366] hover:bg-[#128C7E] text-white font-semibold text-xl transition-colors duration-300"
				>
					<svg class="size-10" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
						<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
					</svg>
					<span>{MENTORING.WHATSAPP_TEXT}</span>
				</a>
			</section>

			<!-- FAQ -->
			<section class="animate space-y-6">
				<h2 class="text-xl font-semibold text-black dark:text-white">
					{MENTORING.FAQ_TITLE}
				</h2>
				<div class="space-y-4">
					{
						MENTORING.FAQ.map((item) => (
							<details class="group rounded-lg border border-black/10 dark:border-white/10 p-4 cursor-pointer">
								<summary class="font-semibold text-black dark:text-white list-none flex justify-between items-center">
									{item.QUESTION}
									<svg
										xmlns="http://www.w3.org/2000/svg"
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
										stroke-linejoin="round"
										class="size-5 transition-transform group-open:rotate-180"
									>
										<polyline points="6 9 12 15 18 9" />
									</svg>
								</summary>
								<p class="mt-3 text-black/70 dark:text-white/70">
									{item.ANSWER}
								</p>
							</details>
						))
					}
				</div>
			</section>
		</div>
	</Container>
</PageLayout>
